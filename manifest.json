{
  "manifest_version": 3,
  "name": "Cookie & Session Hijacking Detector",
  "version": "3.0",
  "description": "Detects, scores, and explains cookie security risks, HTTP header weaknesses, attack patterns, and session hijacking in real time.",

  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "webRequest",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_badge_text": ""
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png"
    }
}
